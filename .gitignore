/bin/
# Комплект для закрытого контура: собирается из исходников (make bundle),
# в репозитории ему делать нечего.
/dist/
/web/node_modules/
/web/dist/
/web/*.tsbuildinfo
/internal/httpapi/webdist/
.env
*.local
# Следы упавших сквозных сценариев: скриншоты и трассировки. Полезны
# ровно до починки.
/web/test-results/
/web/playwright-report/
# Снимки экранов: делаются командой npm run screens и живут ровно
# до следующего разбора.
/web/screenshots/

# Рабочие материалы: план развития по этапам, программа по вёрстке,
# промежуточные ревью макетов и промпты. Они про то, как мы работаем,
# а не про продукт, и читателю репозитория не адресованы. На диске
# остаются, в репозитории им делать нечего.
/ROADMAP.md
/UI-PLAN.md
/PROMPT-FRONTEND.md
/design/
/промпт
*.zip

# Файлы внутреннего пользования: инструкция агенту и его правила
# по фронтенду. На диске нужны, читателю репозитория не адресованы.
/внутренняя-инструкция.md
/внутренние-правила/

# Одноразовые сценарии проверки руками: заводились под конкретный
# разбор, зашивали путь до рабочего каталога и ничем не вызываются.
/web/check-*.mjs
