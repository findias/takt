{
  "name": "board-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' && vitest run",
    "test:dom": "vitest run",
    "test:e2e": "npm run build && playwright test e2e/board.spec.ts e2e/a11y.spec.ts",
    "screens": "npm run build && playwright test e2e/screens.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.7",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
