# Настройки для docker compose. Скопируйте в .env и правьте.
#
# Здесь только то, что читает приложение или compose. Настройки без
# поведения тут быть не должно: она обещает возможность, которой нет,
# — так было со STORAGE, обещавшим вложения в карточках.

# Адрес, по которому приложение открывают в браузере.
# Из него строится адрес потока изменений и ссылки в приглашениях.
# Ошибка здесь даёт не понятную ошибку, а вечный спиннер — клиент
# стучится не туда. Без слэша на конце.
BASE_URL=http://localhost:8080

# Пароль роли приложения. Задайте свой: значение по умолчанию годится
# для стенда и ни для чего больше.
POSTGRES_PASSWORD=takt

# Пароль суперпользователя базы. Приложение им не подключается
# намеренно: для суперпользователя политики изоляции не действуют.
POSTGRES_SUPERUSER_PASSWORD=postgres

# Кто заводит организации: first (первый пришедший становится
# владельцем, дальше по приглашению), open, closed.
SIGNUP=first

# Вход через корпоративного провайдера. Пусто — вход только по паролю.
# OIDC_ISSUER=https://id.example.ru
# OIDC_CLIENT_ID=takt
# OIDC_CLIENT_SECRET=
# OIDC_ORG=example
# OIDC_LABEL=Войти через корпоративный вход
