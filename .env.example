# Адрес, по которому приложение открывают в браузере.
# Из него строится адрес WebSocket-соединения. Ошибка здесь даёт не понятную
# ошибку, а вечный спиннер — клиент стучится не туда. Без слэша на конце.
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://takt:takt@localhost:5432/takt?sslmode=disable

# Место хранения вложений. За одним интерфейсом, чтобы позже подставить S3.
STORAGE=file:///data/attachments

LISTEN_ADDR=:8080
